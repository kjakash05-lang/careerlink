# ==========================================
# CareerLink Frontend Environment Variables
# ==========================================

# Backend REST API Base URL
# Local: http://localhost:5000/api
# Production (Render/Railway): https://careerlink-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO Server URL
# Local: http://localhost:5000
# Production: https://careerlink-api.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Google OAuth 2.0 Client ID (Public identifier for Google Sign-In)
# Note: NEVER put GOOGLE_CLIENT_SECRET in frontend environment variables.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
