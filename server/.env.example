# ==========================================
# CareerLink Backend Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production

# Frontend Client URL (For CORS security & Socket.IO connections)
# Example: https://careerlink.vercel.app
CLIENT_URL=https://careerlink.vercel.app,http://localhost:5173

# Database (Production: MongoDB Atlas Cluster Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/careerlink?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT Secret Key & Expiration
JWT_SECRET=your_super_secure_random_production_jwt_secret_key_at_least_32_characters
JWT_EXPIRE=30d

# Cloudinary Cloud Storage (For persistent profile pictures and PDF resume storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 Credentials (Server-side token verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
